"""
Production settings template. Copy to production.py on the server (gitignored):

    cp tfk_mentors/production.py.example tfk_mentors/production.py

Apache/mod_wsgi must set (on WSGIDaemonProcess, not only SetEnv):

    environment=DJANGO_SETTINGS_MODULE=tfk_mentors.production
"""
import os

# Database — read by tfk_mentors/settings.py on import
os.environ["DB_NAME"] = "myapp_prod"
os.environ["DB_USER"] = "myapp_user"
os.environ["DB_PASSWORD"] = "secure_password"
os.environ["DB_HOST"] = "db"
os.environ["DB_PORT"] = "5432"

# Redis
os.environ["REDIS_URL"] = "redis://redis:6379/0"

# Email
os.environ["EMAIL_HOST"] = "smtp.gmail.com"
os.environ["EMAIL_PORT"] = "587"
os.environ["EMAIL_USE_TLS"] = "1"
os.environ["EMAIL_HOST_USER"] = "your-email@gmail.com"
os.environ["EMAIL_HOST_PASSWORD"] = "app-specific-password"

# Site / deployment — also set explicitly after import below
os.environ["FRONTEND_PUBLIC_URL"] = "https://mentors.runsforkids.com"
os.environ["ALLOWED_HOSTS"] = "api.runsforkids.com"
os.environ["CSRF_TRUSTED_ORIGINS"] = "https://mentors.runsforkids.com"
os.environ["CORS_ALLOWED_ORIGINS"] = "https://mentors.runsforkids.com"
os.environ["TIME_ZONE"] = "America/Chicago"
os.environ["SITE_PASSWORD"] = "change-me"

from tfk_mentors.settings import *  # noqa: E402, F403

DEBUG = False

# Override here so host/CORS work even if Apache env vars are missing.
ALLOWED_HOSTS = ["api.runsforkids.com"]
CSRF_TRUSTED_ORIGINS = ["https://mentors.runsforkids.com"]
CORS_ALLOWED_ORIGINS = ["https://mentors.runsforkids.com"]
FRONTEND_PUBLIC_URL = "https://mentors.runsforkids.com"

SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SECURE = True
SESSION_COOKIE_SAMESITE = "Lax"
CSRF_COOKIE_SAMESITE = "Lax"
