# SPA fallback for React Router (mentor reply links, etc.)
# Requires: sudo a2enmod rewrite  &&  AllowOverride All in the Apache vhost
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
