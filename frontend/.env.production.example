# Copy to .env.production and customize on the server:
#   cp .env.production.example .env.production

# Public URL where the React app is served
VITE_APP_URL=https://your-domain.com

# Backend API base URL (no trailing slash)
# Use the same value as VITE_APP_URL if nginx proxies /api to Django on one domain
VITE_API_URL=https://your-domain.com

# Enable Shopify theme asset output with vite-plugin-shopify.
# When enabled, build assets are written to ./assets and the Liquid snippet
# is generated at ./snippets/vite-tag.liquid.
VITE_SHOPIFY_PLUGIN=false
