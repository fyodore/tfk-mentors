# Apache vhost example for the React frontend (mentors.runsforkids.com)
#
# Copy/adapt to e.g. /etc/apache2/sites-available/mentors.runsforkids.com-le-ssl.conf
# Build the SPA first: cd frontend && npm ci && npm run build
# DocumentRoot must point at frontend/dist (contains index.html + .htaccess)

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName mentors.runsforkids.com

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/mentors.runsforkids.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/mentors.runsforkids.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    DocumentRoot /var/www/tfk-mentors/frontend/dist

    <Directory /var/www/tfk-mentors/frontend/dist>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted

        # SPA fallback — serve index.html for /mentor-reply, /seasons, etc.
        RewriteEngine On
        RewriteBase /
        RewriteRule ^index\.html$ - [L]
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule ^ /index.html [L]
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/mentors-frontend-error.log
    CustomLog ${APACHE_LOG_DIR}/mentors-frontend-access.log combined
</VirtualHost>
</IfModule>
