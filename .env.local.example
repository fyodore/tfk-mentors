# Copy to .env.local for running Django on the host (outside Docker).
# Docker Compose uses the root .env file instead (DB_HOST=db).
# Do not copy this file for Docker-only dev, or Django will try localhost for Postgres.

TFK_LOCAL_DEV=1

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
